 application "Event Registration & Participation Management 3"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Event_Registration_Form
		{
			success message = "Data Added Successfully!"
			Participation
			(
				type = section
				displayname = "Participant Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Participant_Name
			(
    			type = name
				displayname = "Participant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Participant_Type
			(
				type = radiobuttons
				displayname = "Participant Type"
				maxchar = 100
				values = {"Student","Faculty","Professional"}
				initial value = "Student"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Team_Size
			(
				type = number
				displayname = "Team Size"
				maxchar = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contact_Institution_Details
			(
				type = section
				displayname = "Contact & Institution Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
    			allowedcountries={in}
    			defaultcountry="in"
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			College_Organisation_Name
			(
    			type = text
				displayname = "College / Organisation Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Institutional_Address
			(
    			type = address
				displayname = "Institutional Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Event_Preference
			(
				type = section
				displayname = "Event Preference"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Event_Track
			(
				type = picklist
				displayname = "Event Track"
				maxchar = 100
				values = {"AI & Data Science","Cyber Security","Cloud Computing","Robotics","IoT"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Areas_Of_Interest
			(
				type = list	
				displayname = "Areas Of Interest"
				values = {"Agentic Automation,","Generative AI","Cloud Computing"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Expectations_From_Event
			(
    			type = textarea
				displayname = "Expectations From Event"
				height = 100px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Event_Guidelines_Display
			(
    			type = richtext
				height = 100px
				toolbar = disable
    			description
    			[
    				type = tooltip
    			 	message = "Please arrive 30\nminutes early.\nCarry a valid ID.\nNo outside food is\nallowed in the\nvenue."
    			]
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Portfolio_LinkedIn_URL
			(
    			type = url
				enable  linkname
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Profile_Photo
			(
    			type = image
				source  = file,camera
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Registration_Fee_Paid
			(
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			Early_Bird_Discount_Percent
			(
    			type = percentage
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have CGPA
			(
				type = decimal
				displayname = "Academic_CGPA"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Requires_Acco
			(
    			type = checkbox
				displayname = "Requires_Accommodation"
				initial value = false
	 			row = 4
	 			column = 1   
				width = medium
			)
			Scheduling_Acknowledgement
			(
				type = section
				displayname = "Scheduling & Acknowledgement"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			must have Preferred_Session_Slot
			(
    			type = time
				displayname = "Preferred Session Slot"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 5
	 			column = 1   
				width = medium
			)
			Registration_Submitted_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Agree_To_Code_Of_Conduct
			(
				type = checkboxes	
				displayname = "Agree To Code Of Conduct"
				values = {"Agreed"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Team_Members_Details
			(
				type = grid
				maxrow = 6
				t
				(
    				type = name
					displayname = "Teammate Name"
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Teammate_Email
				(
    				type = email
					displayname = "Teammate Email"
					maxchar = 80
					width = medium
					personal data = true
				)
				Role_in_the_team
				(
    				type = text
					displayname = "Role in the team"
					width = medium
				)
				College_Name_Lookup
				(
					type = picklist	
					values  = Event_Registration_Form.ID
    				displayformat = [College_Organisation_Name]
					sortorder = ascending
					width = medium
				)
	 			row = 6
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 7
	 			column = 0   
				width = medium
			)
			must have Participant_Digital_Signature
			(
    			type = signature
	 			row = 7
	 			column = 1   
				width = medium
				personal data = true
			)
			must have ID_Proof_Upload
			(
    			type = upload file
				browse = local_drive
				allowed file formats = {"jpg","pdf","png"}
	 			row = 7
	 			column = 1   
				width = medium
			)
			Special_Requirement_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 7
	 			column = 1   
				width = medium
			)
			must have Team_Intro_Video
			(
    			type = video
    			duration=30
	 			row = 7
	 			column = 1   
				width = medium
			)
			Registration_ID
			(
    			type = autonumber
				start index = 1
	 			row = 7
	 			column = 1   
				width = medium
			)
			Formula
			(
				type = decimal
	 			row = 7
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  Registration_Fee_Paid - Registration_Fee_Paid * Early_Bird_Discount_Percent
    						visibility = false
    			)
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Registration_ID}"
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
